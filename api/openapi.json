  "info": {
    "title": "DonkeyWork Vault | v1",
    "version": "1.0.0"
  },
  "openapi": "3.0.4",
  "paths": {
    "/api/mcp/oauth/callback": {
      "get": {"parameters": [{"in":"query","name":"code","schema":{"type":"string"}},{"in":"query","name":"state","schema":{"type":"string"}},{"in":"query","name":"error","schema":{"type":"string"}}],"responses":{"302":{"description":"OAuth authorization completed"},"400":{"description":"OAuth authorization failed"}},"tags":["DonkeyWork Vault"]}
    },
    "/api/v1/mcp/connections": {
      "get": {"responses":{"200":{"description":"MCP connections","content":{"application/json":{"schema":{"type":"array","items":{"type":"object"}}}}}},"tags":["DonkeyWork Vault"]},
      "post": {"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"MCP connection"},"400":{"description":"Invalid connection"}},"tags":["DonkeyWork Vault"]}
    },
    "/api/v1/mcp/connections/{id}": {
      "put": {"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"MCP connection"},"404":{"description":"Not found"}},"tags":["DonkeyWork Vault"]},
      "delete": {"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Deleted"},"404":{"description":"Not found"}},"tags":["DonkeyWork Vault"]}
    },
    "/api/v1/mcp/connections/{connectionID}/probe": {
      "post": {"parameters":[{"in":"path","name":"connectionID","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"MCP protocol probe result, including compatibility or authorization status"},"404":{"description":"Not found"},"503":{"description":"Probe persistence unavailable"}},"tags":["DonkeyWork Vault"]}
    },
    "/api/v1/mcp/connections/{connectionID}/grants": {
      "get": {"parameters":[{"in":"path","name":"connectionID","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Connection grants"}},"tags":["DonkeyWork Vault"]},
      "post": {"parameters":[{"in":"path","name":"connectionID","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"Grant created"},"404":{"description":"Not found"}},"tags":["DonkeyWork Vault"]}
    },
    "/api/v1/mcp/grants/{id}": {
      "delete": {"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Deleted"},"404":{"description":"Not found"}},"tags":["DonkeyWork Vault"]}
    },
    "/api/v1/mcp/eval-runs": {
      "get": {
        "responses": {"200": {"description": "Eval runs", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/MCPEvalRun"}}}}}},
        "tags": ["DonkeyWork Vault"]
      },
      "post": {
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateMCPEvalRunRequest"}}}},
        "responses": {
          "201": {"description": "Eval run credential created; secret is shown once", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatedMCPEvalRunResponse"}}}},
          "400": {"description": "Invalid eval run"}
        },
        "tags": ["DonkeyWork Vault"]
